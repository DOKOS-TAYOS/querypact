<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>querypact</AssemblyName>
    <RootNamespace>Sav.Host</RootNamespace>
    <!-- Version comes from MinVer (Git height / tags). Do not hardcode InformationalVersion. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
    <!-- Microsoft.Sbom.Targets: generate SPDX on Release builds (also archived via New-Checksums.ps1 / DotNetTool). -->
    <GenerateSBOM Condition="'$(Configuration)' == 'Release'">true</GenerateSBOM>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="MinVer" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Sbom.Targets" PrivateAssets="All" Condition="'$(Configuration)' == 'Release'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sav.Application\Sav.Application.csproj" />
    <ProjectReference Include="..\Sav.Infrastructure.Config\Sav.Infrastructure.Config.csproj" />
    <ProjectReference Include="..\Sav.Infrastructure.Storage\Sav.Infrastructure.Storage.csproj" />
    <ProjectReference Include="..\Sav.Infrastructure.Postgres\Sav.Infrastructure.Postgres.csproj" />
    <ProjectReference Include="..\Sav.Domain\Sav.Domain.csproj" />
  </ItemGroup>
  <Import Project="..\..\build\NativeLibPgQuery.props" />
</Project>
